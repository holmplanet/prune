{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prune.local/schemas/manifest.schema.json",
  "title": "ProtocolManifest",
  "type": "object",
  "required": ["protocol_version", "schemas", "policies", "modes"],
  "additionalProperties": false,
  "properties": {
    "protocol_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "schemas": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^schemas/[^/]+\\.schema\\.json$" }
    },
    "policies": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^policies/[^/]+\\.md$" }
    },
    "modes": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^modes/[^/]+\\.md$" }
    }
  }
}
