{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prune.local/schemas/completion-spec.schema.json",
  "title": "CompletionSpec",
  "type": "object",
  "required": ["status"],
  "additionalProperties": false,
  "properties": {
    "status": { "enum": ["complete", "blocked", "question", "review", "error"] },
    "summary": { "type": "string" },
    "file": { "type": "string" },
    "cause": { "type": "string" },
    "verification": { "type": "array", "items": { "type": "string" } },
    "reason": { "type": "string" },
    "needs": { "type": "string" },
    "findings": { "type": "array", "items": { "type": "object" } }
  }
}
