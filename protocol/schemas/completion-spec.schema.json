{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prune.local/schemas/completion-spec.schema.json",
  "title": "CompletionSpec",
  "type": "object",
  "required": ["status"],
  "additionalProperties": false,
  "properties": {
    "status": { "enum": ["complete", "blocked", "question", "review", "error"] },
    "summary": { "type": "string", "maxLength": 200 },
    "file": { "type": "string" },
    "cause": { "type": "string" },
    "verification": { "type": "array", "items": { "type": "string" } },
    "reason": { "type": "string", "maxLength": 300 },
    "needs": { "type": "string", "maxLength": 200 },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verbosity", "sentences"],
      "properties": {
        "verbosity": {
          "enum": ["minimal", "standard", "expanded"],
          "default": "minimal"
        },
        "sentences": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        }
      }
    },
    "findings": { "type": "array", "items": { "type": "object" } }
  }
}
